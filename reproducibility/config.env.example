# Optional shell template: edit paths, then `source` it as documented.
# Python reads environment variables; it does not auto-load .env.
# Paths can contain spaces. Relative values resolve against the launch cwd.

# Default: <checkout>/work
# export ADL_WORK_ROOT="/absolute/path/to/private-work"
# Default: $ADL_WORK_ROOT/derived/raw_extracts
# export ADL_CHARLS_RAW_DIR="/absolute/path/to/charls/raw_extracts"
# Default: $ADL_WORK_ROOT/rerun_risk_stratification_expanded_v2_20260323
# This is NOT the legacy master's output; obtain the original input package.
# export ADL_EXPANDED_RERUN_ROOT="/absolute/path/to/expanded-v2-locked-package"
# Default: $ADL_WORK_ROOT/data/klosa
# export ADL_KLOSA_DATA_ROOT="/absolute/path/to/klosa"
# Default: $ADL_KLOSA_DATA_ROOT/KLoSA 1-9th wave (STATA)
# export ADL_KLOSA_RAW_DIR="/absolute/path/to/KLoSA 1-9th wave (STATA)"
# Default: $ADL_KLOSA_DATA_ROOT/bukpmcwp.do
# export ADL_GATEWAY_DO="/absolute/path/to/bukpmcwp.do"
# Default: $ADL_WORK_ROOT/gateway_build
# export ADL_GATEWAY_BUILD_ROOT="/absolute/path/to/private-gateway-build"
# Default: $ADL_WORK_ROOT/results/klosa_external_validation/gateway_harmonized_build/GH_KLoSA_f.dta
# Override when using an existing licensed harmonized file.
# export ADL_KLOSA_HARMONIZED_PATH="/absolute/path/to/GH_KLoSA_f.dta"
# Optional absolute executable path or command on PATH; detected otherwise.
# export STATA_BIN="/absolute/path/to/stata-mp"
